AddType application/x-httpd-php .html
ErrorDocument 404 /errors/404.html
ErrorDocument 403 /errors/403.html

Options -Indexes

<Files .htaccess>
order allow,deny
deny from all
</Files>

<Files settings.php>
order allow,deny
deny from all
</Files>

<Files DBConnection.php>
order allow,deny
deny from all
</Files>

<Files Log.php>
order allow,deny
deny from all
</Files>

<Files LogPlugin.php>
order allow,deny
deny from all
</Files>
