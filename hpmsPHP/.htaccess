AddType application/x-httpd-php .html
FallbackResource /errors/404.html
FallbackResource /errors/403.html

Options  -Indexes


<Files ".htaccess">
Order allow,deny
Deny from all
</Files>

<Files "LogPlugin.php">
Order allow,deny
Deny from all
</Files>

<Files "LogPluginSilent.php">
Order allow,deny
Deny from all
</Files>